{
  "name": "provider-router",
  "version": "0.1.0",
  "private": true,
  "description": "Expose your locally configured inference providers through one API",
  "author": "Provider Router contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:runtime": "pnpm exec install-electron",
    "dev": "pnpm run build && pnpm run setup:runtime && electron .",
    "start": "pnpm run setup:runtime && electron .",
    "dist:win": "pnpm run build && electron-builder --win --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "ajv": "8.17.1",
    "electron-updater": "^6.8.9",
    "fs-native-extensions": "1.5.3",
    "smol-toml": "^1.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "electron": "44.10.1",
    "electron-builder": "^26.16.1",
    "esbuild": "^0.25.12",
    "openai": "^7.53.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "npmRebuild": false,
    "appId": "org.providerrouter.desktop",
    "productName": "Provider Router",
    "artifactName": "provider-router-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "protocols": [
      {
        "name": "Provider Router",
        "schemes": [
          "provider-router"
        ]
      }
    ],
    "win": {
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.developer-tools"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Laughcheeta1",
        "repo": "provider-router"
      }
    ]
  }
}
